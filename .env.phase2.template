# =============================================================================
# PHASE 2 — copy to .env and replace every FILL_IN_* value
# =============================================================================
#   cp .env.phase2.template .env
#   nano .env   # or edit in Cursor
#   python scripts/check_setup.py
# =============================================================================

# --- REQUIRED for Phase 2 -----------------------------------------------------

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=FILL_IN_RANDOM_SECRET_KEY

# Admin panel at /admin/login (username is always: admin)
ADMIN_PASSWORD=FILL_IN_YOUR_ADMIN_PASSWORD

# https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=FILL_IN_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=FILL_IN_SPOTIFY_CLIENT_SECRET

# --- Local server (defaults usually fine) -------------------------------------

FLASK_ENV=development
FLASK_DEBUG=True
HOST=::
PORT=5001

# --- Optional -----------------------------------------------------------------

# Uncomment to force one song folder (must exist under audio/OutputWAVS/)
# FORCE_PLAYBACK_BASE_FILENAME=Lit_MyOwnWorstEnemy

# SQLite is automatic when DATABASE_URL is unset
# DATABASE_URL=

# --- Production (Phase 2 does not need these locally) -----------------------

# FLASK_ENV=production
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
