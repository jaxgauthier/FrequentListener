# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Phase 2 checklist (comments + FILL_IN labels):
#   cp .env.phase2.template .env
#   docs/PHASE2_SETUP.md
#   python scripts/check_setup.py
#
# Never commit .env — it is gitignored.

# ==============================================================================
# PHASE 2 — REQUIRED (fill these in before API/backend work)
# ==============================================================================

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login at /admin/login (username: admin). Then: python scripts/create_admin.py
ADMIN_PASSWORD=

# https://developer.spotify.com/dashboard → Create app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ==============================================================================
# Local development (defaults usually fine)
# ==============================================================================

FLASK_ENV=development
FLASK_DEBUG=True
HOST=::
PORT=5001

# SQLite is used automatically when DATABASE_URL is unset.
# DATABASE_URL=sqlite:///absolute/path/to/data/game.db

# Optional: force playback to a specific folder under audio/OutputWAVS/
# FORCE_PLAYBACK_BASE_FILENAME=Lit_MyOwnWorstEnemy

# ------------------------------------------------------------------------------
# Production only
# ------------------------------------------------------------------------------

# FLASK_ENV=production
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# USE_CDN=false
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
