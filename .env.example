# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Phase 2 checklist (comments + FILL_IN labels):
#   cp .env.phase2.template .env
#   docs/PHASE2_SETUP.md
#   python scripts/check_setup.py
#
# Never commit .env — it is gitignored.

# ==============================================================================
# PHASE 2 — REQUIRED (fill these in before API/backend work)
# ==============================================================================

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login at /admin/login (username: admin). Then: python scripts/create_admin.py
ADMIN_PASSWORD=

# https://developer.spotify.com/dashboard → Create app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ==============================================================================
# Local development (defaults usually fine)
# ==============================================================================

FLASK_ENV=development
FLASK_DEBUG=True
HOST=::
PORT=5001

# SQLite is used automatically when DATABASE_URL is unset.
# DATABASE_URL=sqlite:///absolute/path/to/data/game.db

# Optional: force playback to a specific folder under audio/OutputWAVS/
# FORCE_PLAYBACK_BASE_FILENAME=Lit_MyOwnWorstEnemy

# ------------------------------------------------------------------------------
# Production (see docs/DEPLOY.md)
# ------------------------------------------------------------------------------

# FLASK_ENV=production
# FLASK_DEBUG=false
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# AUDIO_OUTPUT_FOLDER=/var/data/OutputWAVS
# UPLOAD_FOLDER=/var/data/uploads
# USE_CDN=false
# CDN_URL=
# LOG_LEVEL=INFO
# LOG_FILE=/var/data/logs/app.log
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# Optional: Netscape-format cookies for admin YouTube download (often required on Render)
# Export from browser — https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
# YTDLP_COOKIES=/etc/secrets/cookies.txt
